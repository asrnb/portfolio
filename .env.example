# Resend API key used to send contact form emails. Required for the contact
# form to work; without it, /api/contact responds with a 503.
RESEND_API_KEY=

# Optional: override the "from" address used for contact form emails.
# Defaults to "Portfolio Contact <onboarding@resend.dev>" if unset.
CONTACT_FROM_EMAIL=

# Optional: override the inbox that receives contact form submissions.
# Defaults to aprilsuarnaba5@gmail.com if unset.
CONTACT_TO_EMAIL=

# Groq API key used to power the portfolio chatbot. Required for the
# chatbot to work; without it, /api/chat responds with a 503.
GROQ_API_KEY=
