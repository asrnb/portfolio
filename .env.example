# Resend API key used to send contact form emails. Required for the contact
# form to work; without it, /api/contact responds with a 503.
RESEND_API_KEY=

# Optional: override the "from" address used for contact form emails.
# Defaults to "Portfolio Contact <onboarding@resend.dev>" if unset.
CONTACT_FROM_EMAIL=

# Optional: override the inbox that receives contact form submissions.
# Defaults to aprilsuarnaba5@gmail.com if unset.
CONTACT_TO_EMAIL=

# Groq API key used to power the portfolio chatbot. Required for the
# chatbot to work; without it, /api/chat responds with a 503.
GROQ_API_KEY=

# Google Calendar service account used by the chatbot's appointment-booking
# tools. Without these, the bot will tell visitors booking isn't available
# yet and to email April directly instead.
# 1. Create a Google Cloud project, enable the Calendar API.
# 2. Create a service account, download its JSON key.
# 3. Share your Google Calendar with the service account's email
#    (Settings > Share with specific people > give "Make changes to events").
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key field from the JSON key, keeping the \n escape codes.
GOOGLE_PRIVATE_KEY=
# Usually your Gmail address, or the calendar ID from Google Calendar settings.
GOOGLE_CALENDAR_ID=
